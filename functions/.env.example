# Non-secret configuration ONLY. Copy to .env.<projectId> for Firebase CLI.
# Before any later deployment, select an owner-approved account in this project.
# Empty preserves existing platform defaults; it is NOT verified least-privilege IAM.
VELNIX_RUNTIME_SERVICE_ACCOUNT=
# Phase one internal orders do not need KMS. Keep empty until separately approved.
# Later use a verified resource name, never the YOUR_PROJECT placeholder.
VELNIX_KMS_KEY=
# Empty until a separately authorized, documented sandbox is approved.
# Click remains blocked in code even if its hostname is later allowlisted.
ALLOWED_DELIVERY_HOSTS=
