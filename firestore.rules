rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Only a user's own non-secret profile is readable through the client SDK.
    // All orders, delivery settings, audit events, and operations are mediated
    // by authenticated Cloud Functions which implement the authorization policy.
    match /members/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
    // A caller can observe only their own decision; never create or approve it.
    match /joinRequests/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
    // Real-time sync revision counters. This document holds counters only — no
    // order, customer or credential data — so any signed-in user may read it to
    // learn that something changed. It is written only by the Cloud Functions
    // triggers (sync.js); clients can never write it.
    match /sync/{docId} {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
